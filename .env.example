# iPhone Scout - Render.com Environment Configuration Example

# Server Port (Render automatically sets PORT)
PORT=3000

# Google Gemini AI API Key (Free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Apify API Token (Optional - Free token from https://apify.com/)
APIFY_API_TOKEN=

# Discord Notifications (Webhook or Bot Token)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Scraper Interval in seconds (Default: 30)
SCRAPE_INTERVAL_SECONDS=30

# Minimum Profit Alert Threshold in CZK (Default: 1000)
MIN_PROFIT_ALERT=1000
